# Template only - copy to ~/.config/layerfmritoolbox/ai.env and source it.
# Keys are read from the shell environment, never committed to the repo.
OPENAI_API_KEY=
# Per-model keys used by the GUI profile selector:
OPENAI_DEEPSEEK_API_KEY=
OPENAI_GPT_API_KEY=
# Fallback endpoint/model; the active model profile overwrites these.
OPENAI_ENDPOINT=https://api.deepseek.com/chat/completions
OPENAI_MODEL=deepseek-v4-flash
OPENAI_DEPLOYMENT=
OPENAI_TIMEOUT_SECONDS=120
LAYERFMRI_PYTHON=python3
